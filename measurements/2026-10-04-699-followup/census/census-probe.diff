+        // This avoids an SRG name assumption and does not invoke any custom collection getter.
+        for (var method : net.minecraft.world.item.CreativeModeTabs.class.getDeclaredMethods()) {
+            if (java.lang.reflect.Modifier.isPublic(method.getModifiers())
+                    && java.lang.reflect.Modifier.isStatic(method.getModifiers())
+                    && method.getParameterCount() == 0 && method.getReturnType() == java.util.List.class) {
+                for (Object tab : (java.util.List<?>) method.invoke(null)) if (seen.add(tab)) tabs.add(tab);
+            }
+        }
+        java.lang.reflect.Method factory = java.util.Arrays.stream(net.minecraft.world.item.ItemStackLinkedSet.class.getDeclaredMethods())
+                .filter(m -> java.lang.reflect.Modifier.isPublic(m.getModifiers()) && java.lang.reflect.Modifier.isStatic(m.getModifiers())
+                        && m.getParameterCount() == 0 && m.getReturnType() == java.util.Set.class).findFirst().orElseThrow();
+        Object reference = factory.invoke(null);
