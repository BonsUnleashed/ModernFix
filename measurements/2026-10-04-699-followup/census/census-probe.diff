+                .filter(m -> m.getParameterCount() == 0 && m.getReturnType() == net.minecraft.world.item.CreativeModeTab.Type.class).findFirst().orElseThrow();
+        int tabIndex = 0;
+        for (Object tab : tabs) {
+            if (String.valueOf(type.invoke(tab)).equals("SEARCH")) continue;
+            for (var method : base.getDeclaredMethods()) {
+                if (!java.lang.reflect.Modifier.isPublic(method.getModifiers()) || java.lang.reflect.Modifier.isStatic(method.getModifiers())
+                        || method.getParameterCount() != 0 || !java.util.Collection.class.isAssignableFrom(method.getReturnType())) continue;
+                var resolved = tab.getClass().getMethod(method.getName());
+                if (resolved.getDeclaringClass() != base) {
+                    System.out.println("MF_NATIVE kind=tab_collection_census tab="+tabIndex+" tab_class="+tab.getClass().getName()+" getter="+method.getName()+" stock_getter=false");
+                    continue; // A custom getter may have side effects; do not call it during a read-only census.
